{
  "name": "serverless-build-todo-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.18.0 || >=24.11.0" },
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "build": "vite build",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "typecheck": "wrangler types --config wrangler.jsonc && tsc --noEmit",
    "bundle:claimable": "wrangler deploy --config wrangler.jsonc --dry-run --outdir dist/worker"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.14.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@phosphor-icons/react": "^2.1.10",
    "agents": "0.26.0",
    "hono": "^4.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "wrangler": "^4.134.0"
  }
}
